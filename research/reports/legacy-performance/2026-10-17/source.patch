+        );
+        drop(input);
+        // Reader ownership survives the stream and its weak recycling cache.
+        assert_eq!(last.get_segments().framed_bytes(), frames[3]);
+        assert_eq!(retained.get_segments().framed_bytes(), frames[0]);
+    }
