+        assert_eq!(
+            super::super::low_water::get(write.as_ref()).unwrap(),
+            128 * 1024
+        );
+        peer.write_all(b"one").unwrap();
+        let mut bytes = vec![0; 128 * 1024];
+        let mut cx = Context::from_waker(futures::task::noop_waker_ref());
