+        assert!(bytes[3..].iter().all(|b| *b == 0x61));
+        read.set_read_hint(1).unwrap();
+        peer.write_all(b"x").unwrap();
+        tokio::time::timeout(
+            std::time::Duration::from_secs(5),
+            read.read_exact(&mut bytes[..1]),
+        )
+        .await
+        .unwrap()
+        .unwrap();
+        assert_eq!(bytes[0], b'x');
+        read.set_read_hint(usize::MAX).unwrap();
