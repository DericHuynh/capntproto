+
+    #[tokio::test]
+    async fn partial_direct_body_read_notifies_progress_and_resumes_after_readiness() {
+        use std::sync::{
+            atomic::{AtomicBool, Ordering},
+            Arc,
+        };
+        use std::task::{Wake, Waker};
