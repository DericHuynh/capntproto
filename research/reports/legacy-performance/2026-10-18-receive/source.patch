+                        assert!(!reject_reset);
+                        assert!(second.get_segments().uses_scratch());
+                        assert_eq!(
+                            second.get_root::<capnp::data::Reader>().unwrap(),
+                            vec![0x91; size]
+                        );
+                        break;
+                    }
+                    Poll::Ready(Err(error)) => {
+                        assert!(reject_reset);
