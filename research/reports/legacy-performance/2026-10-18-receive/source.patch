+                &[1, 2, 3, 4, 5, 6, 7, 8]
+            );
+            if !reject_reset {
+                assert_eq!(input.get_ref().hints.last(), Some(&1));
+                let successor = futures::executor::block_on(input.try_read_message(|_| Ok(false)))
+                    .unwrap()
+                    .unwrap();
+                assert_eq!(
+                    successor.get_root::<capnp::text::Reader>().unwrap(),
+                    "successor"
+                );
+            }
+        }
+    }
