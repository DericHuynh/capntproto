+    }));
+    let mut completion = handle.add_driver(Box::new(driver)).unwrap();
+    drop(runtime);
+    assert!(matches!(
+        poll(Pin::new(&mut completion)),
+        Poll::Ready(Err(_))
+    ));
+    assert_eq!(
+        handle.add_driver(Box::new(probe())).err().unwrap().kind,
+        capnp::ErrorKind::Disconnected
+    );
+}
