+    let app = std::future::poll_fn(|cx| {
+        queued.set(queued.get() + 1);
+        cx.waker().wake_by_ref();
+        Poll::<()>::Pending
+    });
+    let wakes = Arc::new(Wakes::default());
+    let waker = Waker::from(wakes.clone());
+    assert!(pin!(runtime.run(app))
+        .poll(&mut Context::from_waker(&waker))
