@@ -0,0 +1,118 @@
+//! Prototype borrowed implementations of the unchanged workflow operations.
+use super::*;
+use capnp::{
+    capability::ServerHooks,
+    private::capability::{ParamsHook, ResultsHook},
+    traits::HasTypeId,
+};
+
+impl ServerHooks for Service {
+    fn dispatch_borrowed(
+        &self,
+        interface: u64,
+        method: u16,
+        params: &dyn ParamsHook,
+        results: &mut dyn ResultsHook,
+    ) -> Option<capnp::Result<()>> {
+        if interface != workflows::Client::TYPE_ID || method > 1 {
+            return None;
+        }
+        Some((|| {
+            match method {
+                0 => {
+                    let params = params
+                        .get()?
+                        .get_as::<workflows::echo_params::Reader<'_>>()?;
+                    let mut results = results
+                        .get()?
+                        .get_as::<workflows::echo_results::Builder<'_>>()?;
+                    results.set_sequence(params.get_sequence());
+                    results.set_payload(params.get_payload()?);
+                }
+                1 => {
+                    let params = params
+                        .get()?
+                        .get_as::<workflows::open_params::Reader<'_>>()?;
+                    let client: cell::Client = capnp_rpc::new_client(Cell(RefCell::new((
+                        0,
+                        params.get_payload()?.to_vec(),
+                    ))));
+                    results
+                        .get()?
+                        .get_as::<workflows::open_results::Builder<'_>>()?
+                        .set_cell(client);
+                }
+                _ => unreachable!(),
+            }
+            Ok(())
+        })())
+    }
+}
+impl ServerHooks for Cell {
+    fn dispatch_borrowed(
+        &self,
+        interface: u64,
+        method: u16,
+        params: &dyn ParamsHook,
+        results: &mut dyn ResultsHook,
+    ) -> Option<capnp::Result<()>> {
+        if interface != cell::Client::TYPE_ID || method > 1 {
+            return None;
+        }
+        Some((|| {
+            match method {
+                0 => {
+                    let state = self.0.borrow();
+                    let mut results = results.get()?.get_as::<cell::read_results::Builder<'_>>()?;
+                    results.set_version(state.0);
+                    results.set_payload(&state.1);
+                }
+                1 => {
+                    let params = params.get()?.get_as::<cell::write_params::Reader<'_>>()?;
+                    let mut state = self.0.borrow_mut();
+                    if params.get_expected_version() != state.0 {
+                        return Err(capnp::Error::failed("version mismatch".into()));
+                    }
+                    state.0 = state
+                        .0
+                        .checked_add(1)
+                        .ok_or_else(|| capnp::Error::failed("version overflow".into()))?;
+                    state.1 = params.get_payload()?.to_vec();
+                    results
+                        .get()?
+                        .get_as::<cell::write_results::Builder<'_>>()?
+                        .set_version(state.0);
+                }
+                _ => unreachable!(),
+            }
+            Ok(())
+        })())
+    }
+}
+impl ServerHooks for Sink {
+    fn dispatch_borrowed(
+        &self,
+        interface: u64,
+        method: u16,
+        params: &dyn ParamsHook,
+        results: &mut dyn ResultsHook,
+    ) -> Option<capnp::Result<()>> {
+        if interface != callback::Client::TYPE_ID || method != 0 {
+            return None;
+        }
+        Some((|| {
+            let params = params
+                .get()?
+                .get_as::<callback::notify_params::Reader<'_>>()?;
+            if params.get_payload()? != self.payload || params.get_sequence() != self.calls.get() {
+                return Err(capnp::Error::failed("callback payload mismatch".into()));
+            }
+            self.calls.set(self.calls.get() + 1);
+            results
+                .get()?
+                .get_as::<callback::notify_results::Builder<'_>>()?
+                .set_sequence(params.get_sequence());
+            Ok(())
+        })())
+    }
+}
