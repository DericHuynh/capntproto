package capntproto:browser@0.1.0;
// The browser owns QUIC/TLS and lends one authenticated byte stream.
interface transport {
 resource connection {
  read: async func(max-length:u32)->result<list<u8>,string>;
  write: async func(bytes:list<u8>)->result<_,string>;
  close: async func()->result<_,string>;
 }
 connect: async func(url:string,certificate-sha256:list<u8>)->result<connection,string>;
}
world frontend {
 import transport;
 import wasi:clocks/monotonic-clock@0.3.0;
 export greet: async func(url:string,certificate-sha256:list<u8>,prefix:string,value:string)->result<string,string>;
}
