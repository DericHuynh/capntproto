{
  "format": 1,
  "kani_version": "0.68.0",
  "target": "x86_64-unknown-linux-gnu",
  "harnesses": [
    "flow_control::outgoing::proofs::outgoing_full_width_admission_never_wraps_or_revokes_accepted_credit",
    "flow_control::incoming::proofs::incoming_charges_preserve_counts_and_hysteresis",
    "io::output::proofs::buffered_completion_requires_flush_and_never_repeats_accepted_resources",
    "storage::proofs::growing_capacity_preserves_full_width_bounds",
    "messages::queue::proofs::terminal_queue_discards_without_releasing_reader",
    "embargoes::proofs::stale_echo_cannot_open_reused_storage",
    "handoff::proofs::handoff_initial_state",
    "local_table::proofs::local_adopted_range_and_owner_preservation",
    "local_table::proofs::local_dense_reuse_and_domain_isolation",
    "local_table::proofs::local_high_wrap_and_capacity_rollback",
    "messages::proofs::borrowed_request_survives_independent_output_reuse",
    "messages::proofs::borrowed_result_survives_independent_output_reuse",
    "messages::proofs::message_ownership_and_send_lifecycle",
    "messages::proofs::owned_writer_preserves_bytes_until_explicit_publication",
    "messages::proofs::partial_send_completion_preserves_ownership",
    "messages::queue::proofs::fifo_never_overtakes_partial_frame",
    "private::arena::fixed::proofs::fixed_publication_preserves_initialized_prefix",
    "private::arena::fixed::proofs::fixed_reservations_preserve_live_words",
    "private::arena::fixed::proofs::fixed_rollback_preserves_published_prefix",
    "references::proofs::export_reference_transition_preserves_ownership",
    "references::proofs::import_references_wait_for_release_acceptance",
    "completion::proofs::scoped_reply_transfers_once_and_preserves_rejected_owner",
    "completion::proofs::tracked_reply_reclaims_only_unobserved_owner",
    "completion::proofs::shared_reply_claim_preserves_accessible_endpoint_identity",
    "provision::proofs::accept_embargo_replay_and_revoke_preserve_authority",
    "provision::proofs::scoped_embargo_claims_survive_capacity_and_revoke",
    "messages::backing::proofs::stable_segments_cover_full_width_indices",
    "wire_capability::map::proofs::identity_mapping_is_exact_and_bounded",
    "messages::queue::proofs::resources_are_offered_only_before_first_accepted_byte"
  ],
  "controls": [
    {
      "name": "admit-outgoing-at-equality",
      "source": "src/flow_control/policy.rs",
      "from": "if used >= limit {",
      "to": "if used > limit {",
      "harness": "flow_control::outgoing::proofs::outgoing_full_width_admission_never_wraps_or_revokes_accepted_credit",
      "expected_check": "accepted admission stays within its limit"
    },
    {
      "name": "resume-incoming-at-equality",
      "source": "src/flow_control/policy.rs",
      "from": "if was_paused {\n        used >= limit",
      "to": "if was_paused {\n        used > limit",
      "harness": "flow_control::incoming::proofs::incoming_charges_preserve_counts_and_hysteresis",
      "expected_check": "paused input resumes strictly below its limit"
    },
    {
      "name": "grow-beyond-resource-maximum",
      "source": "src/storage/limits.rs",
      "from": "current.saturating_mul(2).min(maximum)",
      "to": "current.saturating_mul(2)",
      "harness": "storage::proofs::growing_capacity_preserves_full_width_bounds",
      "expected_check": "growth cannot exceed its configured maximum"
    },
    {
      "name": "discard-live-queue",
      "source": "src/messages/queue.rs",
      "from": "if !self.failed {",
      "to": "if false {",
      "harness": "messages::queue::proofs::terminal_queue_discards_without_releasing_reader",
      "expected_check": "live output cannot discard an accepted send"
    },
    {
      "name": "clear-owned-writer-before-publication",
      "source": "src/messages.rs",
      "from": "let Self { writer, view } = self;",
      "to": "let Self { writer, mut view } = self; view.fill(0);",
      "harness": "messages::proofs::owned_writer_preserves_bytes_until_explicit_publication",
      "expected_check": "owned writer recovery preserves initialized bytes"
    },
    {
      "name": "overtake-partial-frame",
      "source": "src/messages/queue.rs",
      "from": "if complete {\n            let state = policy::release",
      "to": "if true {\n            let state = policy::release",
      "harness": "messages::queue::proofs::fifo_never_overtakes_partial_frame",
      "expected_check": "FIFO preserves oldest unsent suffix"
    },
    {
      "name": "reuse-buffer-with-pending-send",
      "source": "src/messages/policy.rs",
      "from": "            readers: 0,\n            sends: 0,\n            ..",
      "to": "            readers: 0,\n            ..",
      "harness": "messages::proofs::message_ownership_and_send_lifecycle",
      "expected_check": "queued send retains message buffer"
    },
    {
      "name": "complete-partial-message-send",
      "source": "src/messages/policy.rs",
      "from": "Ok((position + count, count == remaining))",
      "to": "Ok((position + count, true))",
      "harness": "messages::proofs::partial_send_completion_preserves_ownership",
      "expected_check": "partial write keeps send reserved"
    },
    {
      "name": "skip-reference-release-commit",
      "source": "src/references.rs",
      "from": "self.refs.count = 0;",
      "to": "let _ = self;",
      "harness": "references::proofs::import_references_wait_for_release_acceptance",
      "expected_check": "accepted release consumes pending references"
    },
    {
      "name": "skip-fixed-rewind",
      "package": "capntproto-core",
      "source": "src/private/arena/fixed.rs",
      "from": "self.used = checkpoint;",
      "to": "let _ = checkpoint;",
      "harness": "private::arena::fixed::proofs::fixed_rollback_preserves_published_prefix",
      "expected_check": "fixed rollback restores the reservation cursor"
    },
    {
      "name": "reject-exact-capacity",
      "package": "capntproto-core",
      "source": "src/private/arena/fixed/limits.rs",
      "from": "if id != 0 || amount > capacity - used",
      "to": "if id != 0 || amount >= capacity - used",
      "harness": "private::arena::fixed::proofs::fixed_reservations_preserve_live_words",
      "expected_check": "fixed reservation accepts exactly available capacity"
    },
    {
      "name": "replace-adopted-owner",
      "source": "src/local_table.rs",
      "from": "else if self.adopted.get(&id).is_some()",
      "to": "else if false",
      "harness": "local_table::proofs::local_adopted_range_and_owner_preservation",
      "expected_check": "adopted duplicate preserves owner"
    },
    {
      "name": "reuse-embargo-identity",
      "source": "src/embargoes.rs",
      "from": "self.next += 1;",
      "to": "self.next += 0;",
      "harness": "embargoes::proofs::stale_echo_cannot_open_reused_storage",
      "expected_check": "stale echo cannot open a new embargo"
    },
    {
      "name": "clear-published-fixed-segment",
      "package": "capntproto-core",
      "source": "src/private/arena/fixed.rs",
      "from": "let this = core::mem::ManuallyDrop::new(self);",
      "to": "let this = self;",
      "harness": "private::arena::fixed::proofs::fixed_publication_preserves_initialized_prefix",
      "expected_check": "fixed publication preserves initialized bytes"
    },
    {
      "name": "accept-closed-reply",
      "source": "src/completion/state.rs",
      "from": "if !matches!(phase, Phase::Pending) {",
      "to": "if false {",
      "harness": "completion::proofs::scoped_reply_transfers_once_and_preserves_rejected_owner",
      "expected_check": "closed receiver preserves rejected reply owner"
    },
    {
      "name": "discard-canceled-reply",
      "source": "src/completion/state.rs",
      "from": "*phase = Phase::Abandoned(value);",
      "to": "drop(value);",
      "harness": "completion::proofs::scoped_reply_transfers_once_and_preserves_rejected_owner",
      "expected_check": "undelivered reply prevents premature slot reuse"
    },
    {
      "name": "discard-tracked-reply-on-shutdown",
      "source": "src/completion/state.rs",
      "from": "Phase::Value(value) | Phase::Abandoned(value) => Some(value),",
      "to": "Phase::Value(value) | Phase::Abandoned(value) => { drop(value); None },",
      "harness": "completion::proofs::tracked_reply_reclaims_only_unobserved_owner",
      "expected_check": "shutdown recovers unobserved reply owner"
    },
    {
      "name": "reuse-shared-reply-with-live-endpoints",
      "source": "src/completion/state.rs",
      "from": "    endpoints == 0",
      "to": "    true",
      "harness": "completion::proofs::shared_reply_claim_preserves_accessible_endpoint_identity",
      "expected_check": "shared reply refuses live endpoint reuse"
    },
    {
      "name": "replay-provision-accept",
      "source": "src/provision.rs",
      "from": "if self.claimed {",
      "to": "if false {",
      "harness": "provision::proofs::accept_embargo_replay_and_revoke_preserve_authority",
      "expected_check": "one Accept per embargo identifier"
    },
    {
      "name": "ignore-provision-close",
      "source": "src/provision.rs",
      "from": "} else if self.closed {",
      "to": "} else if false {",
      "harness": "provision::proofs::scoped_embargo_claims_survive_capacity_and_revoke",
      "expected_check": "unreleased claim cannot complete at registry close"
    },
    {
      "name": "alias-stable-buffer-offset",
      "source": "src/messages/backing.rs",
      "from": "Some((segment, index - ((1usize << segment) - 1)))",
      "to": "Some((segment, 0))",
      "harness": "messages::backing::proofs::stable_segments_cover_full_width_indices",
      "expected_check": "segment position identifies original index"
    },
    {
      "name": "accept-out-of-range-identity-index",
      "package": "capntproto-core",
      "source": "src/wire_capability/map/policy.rs",
      "from": "if source < count {",
      "to": "if source <= count {",
      "harness": "wire_capability::map::proofs::identity_mapping_is_exact_and_bounded",
      "expected_check": "assertion failed: source < count"
    },
    {
      "name": "resend-resources-after-partial-write",
      "source": "src/messages/queue.rs",
      "from": "(self.position == 0).then_some(&entry.resources)",
      "to": "Some(&entry.resources)",
      "harness": "messages::queue::proofs::resources_are_offered_only_before_first_accepted_byte",
      "expected_check": "attachments stop exactly after first accepted byte"
    }
  ],
  "replaced_models": [
    {
      "module": "RpcIdTables",
      "reason": "Direct proofs exercise the actual free heap, sparse storage, full wire IDs, ownership rejection and high-ID wrap. The prior model used two occupancy bits and only one high allocation.",
      "limits": "Dense-heap induction uses three slots; high/adopted storage uses at most two slots. This does not prove every capacity. Native differential traces, zero-allocation tests, Miri and compile-fail role/borrowing contracts remain."
    },
    {
      "module": "HandoffCounterBoundary",
      "reason": "Verus now checks the production transitions across all valid u64 states, with verus-tla safety induction and fair drain/lift progress. Kani retains the Default wrapper check.",
      "limits": "Application handoff policy only. Authenticated handoff, multi-vat wire ordering and distributed fair-progress TLC models remain."
    }
  ]
}
