+            let chunk = chunks.next()?;
+            if *skip > chunk.len() {
+                *skip -= chunk.len();
+                continue;
+            }
+            let chunk = &chunk[*skip..];
+
+            *skip = 0;
+            if chunk.is_empty() {
+                continue;
+            }
+
+            let take = Ord::min(chunk.len(), *remaining);
+            *remaining -= take;
+            return Some(&chunk[..take]);
+        }
+    }
+}
