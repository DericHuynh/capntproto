diff --git a/quiche/src/lib.rs b/quiche/src/lib.rs
index c4c995e..c348d73 100644
--- a/quiche/src/lib.rs
+++ b/quiche/src/lib.rs
@@ -368,6 +368,11 @@
 //!
 //! * `qlog`: Enable support for the [qlog] logging format.
 //!
+//! * `tokio-clock`: Use Tokio's monotonic clock for protocol timers and packet
+//!   pacing. Construct and drive a connection in the same time domain as the
+//!   application's timers and `SendInfo.at` waits. This enables neither Tokio's
+//!   test utilities nor deterministic entropy. The default uses the OS clock.
+//!
 //! * `custom-client-dcid`: Allow clients to supply a custom DCID when
 //!   initiating a connection. Dangerous if the DCID does not meet QUIC's
 //!   unpredictability and length requirements.
@@ -434,7 +439,11 @@ use crate::stream::StreamPriorityKey;
 pub const PROTOCOL_VERSION: u32 = PROTOCOL_VERSION_V1;
 
 /// Supported QUIC versions.
-const PROTOCOL_VERSION_V1: u32 = 0x0000_0001;
+const PROTOCOL_VERSION_V1: u32 = if cfg!(feature = "noise") {
+    0xff52_5001
+} else {
+    0x0000_0001
