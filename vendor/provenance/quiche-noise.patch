+    use snow::params::DHChoice;
+    use snow::resolvers::CryptoResolver;
+    use snow::resolvers::DefaultResolver;
+
+    let (private, peer_private) = if is_server {
+        ([0x22; 32], [0x11; 32])
+    } else {
+        ([0x11; 32], [0x22; 32])
+    };
+    let mut dh = DefaultResolver
